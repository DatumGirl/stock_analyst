# Copy to .env.local (gitignored) and fill in. Production reads these from
# Supabase Vault / service environment variables, never from a file in the repo.

# ── Local Docker (default) ────────────────────────────────────────────────────
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_ENCRYPTED=false
MEMGRAPH_QUERY_TIMEOUT_SECONDS=30

# ── Memgraph Cloud ────────────────────────────────────────────────────────────
# Get these from https://cloud.memgraph.com → your instance → Connect
#
# MEMGRAPH_HOST=YOUR_INSTANCE_ID.cloud.memgraph.com
# MEMGRAPH_PORT=7687
# MEMGRAPH_USERNAME=memgraph
# MEMGRAPH_PASSWORD=your-cloud-password
# MEMGRAPH_ENCRYPTED=true      ← required: Cloud always uses TLS
# MEMGRAPH_QUERY_TIMEOUT_SECONDS=30

# Traversal tuning
GRAPH_MAX_HOPS=3
GRAPH_MIN_SHARED_POSITIONS=2
GRAPH_MIN_EXPOSURE_WEIGHT=0.05
GRAPH_PROPAGATION_DECAY=0.5
